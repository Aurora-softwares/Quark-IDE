<?xml version="1.0" encoding="UTF-8"?>
<Window version="1" id="quarkIDE" title="Quark IDE — Hydrogen Development Environment" width="1650" height="980" theme="system" material="auto" onLoad="LoadSession">
  <MenuBar>
    <Menu text="File">
      <MenuItem id="newFileMenu" text="New Hydrogen file" shortcut="Primary+N" onClick="NewSource" />
      <MenuItem id="openProjectMenu" text="Open project or solution…" onClick="OpenProjectHelp" />
      <MenuItem id="saveMenu" text="Save" shortcut="Primary+S" onClick="SaveActive" />
      <MenuItem id="saveAllMenu" text="Save all" shortcut="Primary+Shift+S" onClick="SaveAll" />
      <MenuItem id="backToStartMenu" text="Return to Start Window" onClick="BackToStart" />
    </Menu>
    <Menu text="Edit" />
    <Menu text="View">
      <MenuItem id="viewCode" text="Hydrogen editor" shortcut="Primary+1" onClick="ShowCode" />
      <MenuItem id="viewUI" text="Hydrogen UI XML" shortcut="Primary+2" onClick="ShowUI" />
      <MenuItem id="viewOutput" text="Output" onClick="ShowOutput" />
    </Menu>
    <Menu text="Git" />
    <Menu text="Project"><MenuItem id="projectOverview" text="Project properties" onClick="ProjectInfo" /></Menu>
    <Menu text="Build">
      <MenuItem id="checkMenu" text="Check project" onClick="Check" />
      <MenuItem id="buildMenu" text="Build solution" shortcut="Primary+Shift+B" onClick="Build" />
    </Menu>
    <Menu text="Debug"><MenuItem id="runMenu" text="Run without debugging" onClick="Run" /></Menu>
    <Menu text="Test" />
    <Menu text="Analyze" />
    <Menu text="Tools" />
    <Menu text="Extensions" />
    <Menu text="Window" />
    <Menu text="Help"><MenuItem id="aboutMenu" text="About Quark" onClick="About" /></Menu>
  </MenuBar>
  <Toolbar id="mainToolbar">
    <ToolButton id="toolbarHome" text="Start" onClick="BackToStart" />
    <ToolButton id="toolbarCode" text="Source" onClick="ShowCode" />
    <ToolButton id="toolbarUI" text="HYUI" onClick="ShowUI" />
    <ToolButton id="toolbarSave" text="Save" onClick="SaveActive" />
    <ToolButton id="toolbarCheck" text="Check" onClick="Check" />
    <ToolButton id="toolbarBuild" text="Build" onClick="Build" />
    <ToolButton id="toolbarRun" text="Run without debugging" onClick="Run" />
  </Toolbar>
  <RowPanel breakpoint="800" gap="12">
    <Label text="Q  /  QUARK" role="caption" tone="accent" />
    <Label text="Configuration: Debug" role="caption" />
    <Label text="Target: host CPU" role="caption" tone="muted" />
    <Label id="startupProject" text="No startup project selected" role="caption" tone="muted" />
  </RowPanel>
  <RowPanel breakpoint="1180" gap="9">
    <Panel title="TOOLBOX" preferredWidth="180" gap="8">
      <Label text="HYDROGEN UI CONTROLS" role="caption" tone="accent" />
      <ListBox id="toolboxItems" items="Label|Button|Text Box|Check Box|Multiline Text Box|Radio Group|Combo Box|List Box|Slider|Panel|Tab Control|Progress Bar|Image" value="0" height="365" onChange="SelectTool" accessibleName="Hydrogen UI toolbox" />
      <Label text="Component selection is available. Visual drag and drop requires Hydrogen UI designer APIs." role="caption" tone="muted" />
    </Panel>
    <ColumnPanel gap="8">
      <RowPanel breakpoint="620" gap="10">
        <Label id="documentTitle" text="No document selected" role="heading" />
        <Label id="fileMode" text="Hydrogen editor" role="caption" tone="accent" />
      </RowPanel>
      <Tabs id="editorTabs" value="0">
        <Tab id="codeTab" title="Hydrogen  ·  .hy" gap="8">
          <RowPanel breakpoint="520" gap="8">
            <Label id="codeName" text="No source file opened" tone="muted" />
            <Button id="newCodeButton" text="New" onClick="NewSource" />
            <Button id="saveCodeButton" text="Save" onClick="SaveSource" />
            <FilePicker id="saveCodeAs" mode="save" text="Save as…" onPick="SourceSaveAsPicked" onCancel="PickerCancelled" />
          </RowPanel>
          <TextArea id="codeText" text="" placeholder="using System;&#10;&#10;public class Program {&#10;    public static int Main(string[] args) {&#10;        return 0;&#10;    }&#10;}" height="500" accessibleName="Hydrogen code editor" />
          <Label text="Native plain-text editor. Line numbers, syntax colouring, completion and editor history need additional Hydrogen UI APIs." role="caption" tone="muted" />
        </Tab>
        <Tab id="uiTab" title="Hydrogen UI  ·  .hyui" gap="8">
          <RowPanel breakpoint="520" gap="8">
            <Label id="uiName" text="No layout opened" tone="muted" />
            <Button id="saveUIButton" text="Save layout" onClick="SaveUI" />
            <FilePicker id="saveUIAs" mode="save" text="Save as…" onPick="UISaveAsPicked" onCancel="PickerCancelled" />
            <Button id="previewButton" text="Open native UI" onClick="Preview" />
          </RowPanel>
          <TextArea id="uiText" text="" placeholder="Open a .hyui document to edit its native UI XML." height="500" accessibleName="Hydrogen UI XML editor" />
          <Label text="The interactive preview uses Hydrogen's actual native runtime. It is not a fake in-editor picture." role="caption" tone="muted" />
        </Tab>
      </Tabs>
    </ColumnPanel>
    <ColumnPanel gap="8">
      <Panel title="SOLUTION EXPLORER" preferredWidth="300" gap="8">
        <Label id="projectTitle" text="No project loaded" role="heading" />
        <Label id="projectPathLabel" text="Open a Hydrogen .hyproj project to begin." tone="muted" />
        <FilePicker id="workspaceProjectPicker" mode="open" text="Open project…" onPick="ProjectPicked" onCancel="PickerCancelled" />
        <Separator />
        <Label text="PROJECT FILES" role="caption" tone="accent" />
        <TextArea id="projectFileList" text="No project files listed" height="210" enabled="false" accessibleName="Project source files" />
        <RowPanel breakpoint="0" gap="7">
          <NumberInput id="projectFileNumber" value="1" minimum="1" maximum="129" accessibleName="Source file number" />
          <Button id="openIndexedFile" text="Open selected file" onClick="ExploreSelected" />
        </RowPanel>
        <FilePicker id="workspaceSourcePicker" mode="open" text="Open a Hydrogen source…" onPick="SourcePicked" onCancel="PickerCancelled" />
        <FilePicker id="workspaceUIPicker" mode="open" text="Open a HYUI layout…" onPick="UIPicked" onCancel="PickerCancelled" />
        <Button id="projectInfoButton" text="View project manifest" onClick="ProjectInfo" />
      </Panel>
      <Panel title="PROPERTIES" preferredWidth="300" gap="8">
        <Label id="propertyName" text="No selection" role="heading" />
        <Label id="propertyType" text="Select a file or project." tone="muted" />
        <Separator />
        <Label text="BUILD TOOLS" role="caption" tone="accent" />
        <Input id="compiler" text="hy" placeholder="Path to Hydrogen compiler" accessibleName="Hydrogen compiler executable" />
        <Label text="TEXT SEARCH" role="caption" tone="accent" />
        <Input id="searchQuery" text="" placeholder="Find in current file…" accessibleName="Search in current editor" />
        <Input id="replaceQuery" text="" placeholder="Replace with…" accessibleName="Replacement text" />
        <RowPanel gap="6">
          <Button id="findButton" text="Find" onClick="Find" />
          <Button id="replaceFirstButton" text="Replace first" onClick="ReplaceFirst" />
          <Button id="replaceAllButton" text="Replace all" onClick="ReplaceAll" />
        </RowPanel>
        <Label id="searchResult" text="Ready to search" tone="muted" />
      </Panel>
    </ColumnPanel>
  </RowPanel>
  <Panel title="OUTPUT / ERROR LIST / DEBUG / TESTS" gap="6">
    <RowPanel breakpoint="680" gap="9">
      <Button id="checkButton" text="Check" onClick="Check" />
      <Button id="buildButton" text="Build solution" primary="true" onClick="Build" />
      <Button id="runButton" text="Start without debugging" onClick="Run" />
      <Button id="runUI" text="Preview HYUI" onClick="Preview" />
    </RowPanel>
    <Tabs id="bottomTabs" value="0">
      <Tab id="outputTab" title="Output">
        <TextArea id="output" text="Compiler results appear here after Check, Build or Run." height="140" enabled="false" accessibleName="Compiler output" />
      </Tab>
      <Tab id="errorsTab" title="Error list">
        <Label text="Structured diagnostics and clickable error locations are planned." tone="muted" />
      </Tab>
      <Tab id="debugTab" title="Debug">
        <Label text="The Hydrogen debugger adapter has not been implemented. Run does not start debugging." tone="muted" />
      </Tab>
      <Tab id="testTab" title="Tests">
        <Label text="Test Explorer will be implemented when Hydrogen exposes test discovery results." tone="muted" />
      </Tab>
      <Tab id="findTab" title="Find">
        <Label text="Use Properties / Text Search to locate the first matching line." tone="muted" />
      </Tab>
    </Tabs>
    <Label id="status" text="Ready · No project opened" role="caption" tone="muted" />
  </Panel>
  <Input id="projectState" text="" visible="false" />
  <Input id="codePath" text="" visible="false" />
  <Input id="uiPath" text="" visible="false" />
  <Input id="manifestState" text="" visible="false" />
  <Dialog id="aboutDialog" title="Quark IDE — Hydrogen" text="A native Hydrogen IDE under development. Rich editor, debugger, and designer capabilities are still planned." buttons="OK" open="false" />
</Window>
